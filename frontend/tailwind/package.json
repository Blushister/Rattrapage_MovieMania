{
  "name": "moviemania-tailwind",
  "version": "1.0.0",
  "description": "Tailwind CSS configuration for MovieMania",
  "scripts": {
    "dev": "tailwindcss -i ./main.css -o ../static/css/styles.css --watch",
    "build": "tailwindcss -i ./main.css -o ../static/css/styles.css",
    "build:prod": "tailwindcss -i ./main.css -o ../static/css/styles.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10"
  }
}